    "axes[0].hist(u_samples[:, 0], bins=40, density=True)\n",
    "axes[0].set_title(\"First coordinate: Uniform[0,1]\")\n",
    "axes[1].hist(g_samples[:, 0], bins=40, density=True)\n",
    "axes[1].set_title(\"First coordinate: Gaussian N(0, 1/2)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
